# Application Settings
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database & Cache (Dùng local hoặc Docker)
DATABASE_URL="postgresql://lughx_admin:lughx_secure_pass@localhost:5432/lughx_db?schema=public"
REDIS_URL="redis://localhost:6379"

# Discord Bot Credentials
# Lệnh bot mặc định: !l (ví dụ: !lhelp, !lping)
DISCORD_PREFIX="!l"
DISCORD_BOT_TOKEN="YOUR_BOT_TOKEN_HERE"
DISCORD_CLIENT_ID="YOUR_CLIENT_ID_HERE"
DISCORD_CLIENT_SECRET="YOUR_CLIENT_SECRET_HERE"
DISCORD_REDIRECT_URI="http://localhost:5000/api/auth/callback"

# Security Secrets
SESSION_SECRET="lughx_super_secret_session_key_32_chars_min"
COOKIE_SECRET="lughx_cookie_secret_key_32_chars_min"